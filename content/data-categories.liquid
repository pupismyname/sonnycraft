---
pagination:
  data: collections.categories
  size: 1
  alias: slug
eleventyComputed:
  title: "{{ slug }} work"
permalink: "/categories/{{ slug }}/"
---

{% assign category = categoryList | find: "slug", slug %}

<header>
  <h1>{{ category.title }}</h1>
</header>
<ul class="list-portfolio">
  {% for item in collections.portfolio %}
    {% if item.data.categories contains slug %}
      {% render "list-portfolio-item.liquid", item: item %}
    {% endif %}
  {% endfor %}
</ul>
