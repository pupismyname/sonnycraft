<li>
  <a class="list-entry-link" href="{{ image.image }}">
    <img alt="{{ image.title | default: image.image }}" src="{{ image.image }}">
  </a>
  <div class="list-entry-details">
    <h3>{{ image.title | default: image.image }}</h3>
    <div class="list-entry-description">
      {{ image.description }}
    </div>
  </div>
</li>
