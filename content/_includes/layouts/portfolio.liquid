---
layout: layouts/content.liquid
---

<header class="entry-header">
  <h1>{{ title | default: "No title"}}</h1>
  <div class="meta">
    <p class="meta-date"><a href=".">{{ date | niceDate }}</a></p>
    <ul class="list-tags meta-categories">
      {% render "list-categories", slugs: categories, list: categoryList %}
    </ul>
  </div>
</header>

<div class="section-entry entry-body">
  {{ content }}
</div>

{% if images != blank %}
  <div class="section-entry entry-gallery">
    <h2>Gallery</h2>
    <ul class="list-entry">
      {% for image in images %}
        {% render "list-entry-item.liquid", image: image %}
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% if references != blank %}
  <aside class="section-entry entry-references">
    <h2>References</h2>
    <ul class="list-entry">
      {% for image in references %}
        {% render "list-entry-item.liquid", image: image %}
      {% endfor %}
    </ul>
  </aside>
{% endif %}
