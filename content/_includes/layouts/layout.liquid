---
published: true
---
<!doctype html>
<html lang="en">
  <head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} - {% endif %}{{ global.title }}</title>

    <style>
      body {
        font-family: sans-serif;
      }
      .icon {
        width: auto;
        height: 1em;
      }
      img {
        max-width: 100%;
      }
    </style>

    <link rel="stylesheet" href="/styles/main.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Borel&display=swap" rel="stylesheet">
    <link rel="alternate" title="Subscribe" type="application/atom+xml" href="/feed.xml">
    <meta name="description" content="{{ global.description }}">
    <meta name="generator" content="{{ eleventy.generator }}">

    {% comment -%} <meta property="og:title" content=""> {% endcomment -%}
    {% comment -%} <meta property="og:type" content=""> {% endcomment -%}
    {% comment -%} <meta property="og:url" content=""> {% endcomment -%}
    {% comment -%} <meta property="og:image" content=""> {% endcomment -%}
    {% comment -%} <meta property="og:image:alt" content=""> {% endcomment -%}

    {% comment -%} <link rel="icon" href="/favicon.ico" sizes="any"> {% endcomment -%}
    {% comment -%} <link rel="icon" href="/icon.svg" type="image/svg+xml"> {% endcomment -%}
    {% comment -%} <link rel="apple-touch-icon" href="icon.png"> {% endcomment -%}

  </head>
  <body>
    <div class="wrapper">

      <header class="masthead">
        <h1><a href="/">{{ global.title }}</a></h1>
        <nav>
          <ul>
            {% render "list-categories", slugs: collections.categories, list: categoryList %}
          </ul>
        </nav>
      </header>

      {% if global.bio %}
        <aside class="bio">
          {{ global.bio }}
        </aside>
      {% endif %}

      {{ content }}

      <footer>
        <p>&copy; {{ global.title }}</p>
        <p>
          <a href="/feed.xml">
            <img class="icon" alt="Subscribe" src="/images/feed.svg"> Subscribe
          </a>
        </p>
      </footer>

    </div>
  </body>
</html>
