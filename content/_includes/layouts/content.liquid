---
layout: layouts/layout.liquid
---

<main>
  {{ content }}
</main>

{% if collections.featured != blank or collections.portfolio != blank %}

  <aside class="explore">

    <h1>More from {{ global.author }}</h1>

    {% if collections.featured != blank %}
      <div class="group-portfolio group-portfolio-featured">
        <h2>Featured</h2>
        <ul class="list-portfolio">
          {% for item in collections.featured limit:6 %}
            {% render "list-portfolio-item.liquid", item: item %}
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% if collections.portfolio != blank %}
      <div class="group-portfolio group-portfolio-recent">
        <h2>Recent</h2>
        <ul class="list-portfolio">
          {% for item in collections.portfolio limit:6 %}
            {% render "list-portfolio-item.liquid", item: item %}
          {% endfor %}
        </ul>
      </div>
    {% endif %}

  </aside>

{% endif %}
