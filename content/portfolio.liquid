---
layout: layouts/layout.liquid
---

<main>
  <div class="group-portfolio">
    {% if collections.portfolio != blank %}
      <header>
        <h1>Full Portfolio</h1>
      </header>
      <ul class="list-portfolio">
        {% for item in collections.portfolio reversed %}
          {% render "list-portfolio-item.liquid", item: item %}
        {% endfor %}
      </ul>
    {% else %}
      <p>Nothing in the portfolio yet.</p>
    {% endif %}
  </div>
</main>
